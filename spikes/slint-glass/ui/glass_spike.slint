// Liquid Glass 的第一个对照 Demo（issue #130，评估文档 §6 第 1 步）。
//
// 2026-11-24 起已编过并在 Windows/FemtoVG 与 Android/Skia 两端跑过。
//
// 它要回答的只有一个问题：
//
//   Slint 1.19 原生的 `Rectangle::backdrop-blur` + 渐变 + 边框 + 阴影，
//   照着 Flutter 版 GlassNavigationSurface 的参数摆出来，和首页那条导航栏
//   差多少？
//
// 如果差的只有「边缘折射」和「单点高光」两件事，那 #130 的 wgpu 管线就是
// 在原生模糊之上补两个效果，而不是重做整条背景捕获链——这个差别足够大，
// 大到应该在动手搭管线之前先量一次。
//
// 刻意**没有**用到的东西，别当成遗漏：
// - 这个文件里没有 wgpu、没有自定义 shader。自绘那一层整个在
//   `src/gl_probe.rs` 里，画在 Slint 画完之后（`--features gl-probe`）；
//   这边只负责原生那条对照、布局，以及把矩形告诉 Rust。
// - 多尺度模糊 / Fresnel / 动态高光 / 融合都在自绘那一层，不在这里。
//   原生 `backdrop-blur` 只有「一档 σ 的模糊」这一件事，这正是要对照的。

// 背景：一条持续横移的彩色条带。
//
// 必须是**动的**——#130 要求「在动态背景下」验证，而静态背景会把两类问题
// 一起藏掉：背板是不是每帧都重新捕获，以及滚动时糊得跟不跟得上。
component MovingBackdrop inherits Rectangle {
    in property <float> phase;
    background: #10131a;

    for i in 14: Rectangle {
        // 用 phase 推着走，走到头从另一侧回来。
        x: Math.mod(i * 90px / 1px + root.phase * 240, root.width / 1px + 90) * 1px - 90px;
        y: 0;
        width: 56px;
        height: root.height;
        background: i.mod(3) == 0
            ? #3b82f6
            : (i.mod(3) == 1 ? #ec4899 : #22c55e);
        opacity: 0.55;
    }

    Text {
        x: 24px;
        y: 24px;
        text: "动态背景：条带持续横移。静态背景会同时藏掉「背板有没有每帧重捕获」和「滚动时糊得跟不跟得上」两个问题。";
        wrap: word-wrap;
        width: root.width - 48px;
        color: white;
        font-size: 15px;
    }
}

// 玻璃胶囊。参数逐个对着 Flutter 侧抄，来源标在每一行后面。
//
// 对照源：
//   lib/common/widgets/floating_navigation_bar.dart  （材质层：渐变/边框/阴影/尺寸）
//   shaders/liquid_glass.frag                        （折射与 glint，这里做不到）
component GlassCapsule inherits Rectangle {
    in property <length> blur-sigma: 10px;
    // 只开模糊：背景、描边、阴影全部让出去，矩形里只剩「被原生糊过的背景」。
    //
    // 这是 ADR-016 决策四那个组合的另一半。决策四说「原生负责模糊、自绘负责
    // 折射与高光」，但没说原生那层的渐变与描边归谁画——两层都画就是双份，
    // 而让原生画、自绘再折射的话，折射会把那道 1px 白描边一起抹开。
    // 让出去之后自绘那层采到的是干净的模糊背景，描边由它自己最后画。
    in property <bool> blur-only: false;
    // _kNavigationHeight。做成 in property 而不是写死，是因为「摆 10 条」时
    // 要靠缩小胶囊把它们真的放进屏幕里——见 GlassSpike 里 slot 的说明。
    in property <length> capsule-height: 80px;

    height: root.capsule-height;
    border-radius: self.height / 2;    // _kBorderRadius = 高度 / 2，胶囊

    // #130 的 P0「实时背景模糊」。Slint 1.19.0 新增，对应 CSS 的
    // backdrop-filter: blur()。值是高斯标准差。
    //
    // 10px 这个初值不是拍的：Flutter 侧在后端不支持自定义 shader 时整体退到
    // ImageFilter.blur(sigma 10)，那条回退路径就是 Low 档要对齐的目标。
    backdrop-blur: root.blur-sigma;

    // 表面渐变 topLeft → bottomRight，alpha 0.24 / 0.10 / 0.18。
    // 这里用白色近似 Flutter 的 ColorScheme.surface——真正接进应用时换成
    // 主题色，Demo 阶段固定值更好比对。
    background: root.blur-only ? transparent : @linear-gradient(135deg,
        #ffffff3d 0%,    // 0.24
        #ffffff1a 50%,   // 0.10
        #ffffff2e 100%); // 0.18

    // 白色描边 alpha 0.36。
    border-width: root.blur-only ? 0px : 1px;
    border-color: #ffffff5c;

    // 外层阴影：黑 alpha 0.22，blur 22，offset (0, 7)。
    drop-shadow-color: #00000038;
    drop-shadow-blur: root.blur-only ? 0px : 22px;
    drop-shadow-offset-x: 0;
    drop-shadow-offset-y: 7px;
}

export component GlassSpike inherits Window {
    title: "KiliKili SPIKE — Liquid Glass 对照 (#130)";
    preferred-width: 900px;
    preferred-height: 560px;
    background: #0b0d12;

    // 背景动画的相位。Slint 的 animate 要有属性变化才会跑，所以用 Timer 推。
    property <float> phase: 0;
    // 模糊强度做成可调：对照时要能一眼看出「调模糊能不能补上折射的缺失」
    // ——答案大概率是不能，但这正是要给看的人确认的那一下。
    in-out property <length> blur-sigma: 10px;
    // 同时摆几条玻璃。见下面 for 循环处的说明。
    in-out property <int> glass-count: 1;

    // 背景动画 Timer 的周期，毫秒。
    //
    // 它曾经写死 16ms，而 16ms = 62.5Hz——**正好压在 60Hz 刷新率旁边**，
    // 于是「帧率读数 61」有两种解释（撞到 vsync / 撞到这个 Timer），
    // 两种解释导向完全相反的结论。做成可调就是为了把这两者分开：
    // 把它调到 4ms（250Hz）之后读数还是 61，才能说是 vsync 的锅。
    in-out property <int> tick-ms: 16;

    // GL 覆盖探针（`--features gl-probe`）。关口 2 本体：背板是本帧真实
    // 帧缓冲，不是合成的。见 src/gl_probe.rs。
    //
    // 开着的时候**原生胶囊整体上移一格**，最底下那格让给 GL 玻璃。这不是
    // 排版偏好，是自采：GL 玻璃的背板是整帧拷下来的，矩形压在原生胶囊上
    // 就会采到玻璃自己，画面一帧比一帧白。让出一格之后，两条玻璃在同一片
    // 移动的背景上下相邻——「原生只有模糊」和「自绘有折射有高光」的差别
    // 一眼就能看出来，这正是 Phase 1 要的那笔账。
    in-out property <bool> gl-overlay-visible: false;
    // GL 覆盖怎么摆。由 `GLASS_GL_LAYOUT` 决定，见 gl_probe::install。
    //
    //   0 slot       自绘玻璃单占最底下一格，背板里**没有**原生玻璃（Phase 1 的摆法）
    //   1 over-full  自绘盖在**完整**原生胶囊上（模糊 + 渐变 + 描边都归原生）
    //   2 over-blur  自绘盖在**只开模糊**的原生胶囊上（渐变与描边归自绘）
    //   3 merge      slot 摆法 + 第二个形状，演示 SDF 融合
    //
    // 1 和 2 是 ADR-016 决策四那条「决策已定、实现待验」要验的两种读法：
    // 同样是「原生模糊 + 自绘折射」，谁画材质层决定了描边会不会被折射抹开。
    in-out property <int> gl-overlay-mode: 0;
    // Rust 侧填的档位串（材质档 / 质量档 / 摆法）。印在画面上，截图自带档位
    // ——档位只活在环境变量里、画面上看不出来，是第一轮记错档位的根因。
    in-out property <string> gl-status: "";

    // 自绘玻璃占不占自己那一格。over-* 两档是**盖在原生上**，不占格。
    property <bool> gl-own-slot: root.gl-overlay-visible
        && (root.gl-overlay-mode == 0 || root.gl-overlay-mode == 3);
    // 原生那条只开模糊（over-blur 档）。
    property <bool> native-blur-only: root.gl-overlay-visible && root.gl-overlay-mode == 2;

    // 让 Rust 侧读的矩形，逻辑像素。**布局只在这里算一次**：Rust 重算一遍
    // 就会和原生胶囊的摆法漂移，而两者摆得一不一样正是要看的东西。
    //
    // 这一式在两种摆法下都对：gl-own-slot 时自绘占最底下那格、原生整体上移
    // 一格；over-* 时 gl-gap 为 0、原生不上移，于是它正好压在第一条原生
    // 胶囊上——那正是 over-* 要的「同一个矩形」。
    // 融合那一档整体右移半个预留宽度，好让「圆 + 胶囊」这个并集居中。
    out property <length> overlay-x: (root.width - root.capsule-width) / 2
        + root.merge-reserve / 2;
    out property <length> overlay-y: root.stack-bottom - root.capsule-height;
    out property <length> overlay-w: root.capsule-width;
    out property <length> overlay-h: root.capsule-height;
    // 圆角。胶囊 = 半高；换成圆角矩形或圆只要改这一项，形状在
    // glass_sdf.glsl 里是同一个 SDF。
    out property <length> overlay-radius: root.capsule-height / 2;

    // ---- 融合演示（gl-overlay-mode == 3）的第二个形状 ----
    //
    // 一个直径 = 胶囊高度的圆，沿水平方向靠过来又离开。为什么是圆而不是
    // 第二条胶囊：圆和胶囊共用同一个 SDF（只有圆角不同），一张图里同时
    // 出现两种形状，正好把「三种形状是同一个 SDF」这件事也验了。
    out property <bool> overlay2-visible: root.gl-overlay-visible && root.gl-overlay-mode == 3;
    out property <length> overlay2-w: root.capsule-height;
    out property <length> overlay2-h: root.capsule-height;
    out property <length> overlay2-radius: root.capsule-height / 2;
    // 间距在 -6px（略微重叠）与 150px 之间来回。颈部在间距小于融合半径
    // （material.rs 的 merge_k = 24px）的那一段才长得出来，所以这个行程
    // **必须跨过 24px**，否则截图上永远只有「两个分开的形状」或「一坨」。
    // 间距默认跟着 phase 来回走；`GLASS_MERGE_GAP` 填了就钉死在那个值上。
    //
    // 钉得住很要紧：动画相位取决于「窗口起来之后 Timer 跑了多久」，而那段
    // 启动耗时每次都不一样（实测三张本该不同间距的截图，量出来是 125 / 75 /
    // 150px，和预期对不上）。拿动画中的某一帧当证据，记录里那个数字是碰
    // 运气来的。
    in-out property <float> merge-gap-override: -1;
    out property <length> merge-gap: root.merge-gap-override >= 0
        ? root.merge-gap-override * 1px
        : -6px + 156px * (0.5 + 0.5 * Math.cos(root.phase * 720deg));
    out property <length> overlay2-x: root.overlay-x - root.overlay2-w - root.merge-gap;
    out property <length> overlay2-y: root.overlay-y;

    // 自绘纹理的位置。只有 `--features wgpu-probe` 那条路会填它，默认整块
    // 不显示——探针没跑的时候画面必须和之前完全一样，否则对照组就变了。
    //
    // 它存在的理由是 #130 的关口 2：原生 backdrop-blur 给不了边缘折射和
    // 单点高光，补这两件事就得自己出一张纹理交给 Slint。这块地方就是
    // 「交得进来吗」的落点。
    in-out property <image> probe-texture;
    in-out property <bool> probe-visible: false;

    // 这一组是 2026-11-24 那轮踩坑之后加的，不是布局洁癖。
    //
    // 原来的摆法是固定 92px 间距、固定 80px 高，于是 `GLASS_COUNT=10`
    // 在 915×597 的桌面窗口里**只画得出 6 条**，多出来的 y 为负、裁在窗外，
    // 而帧率读数照常产出——记录里那一档的标签就是错的（notes §4.1）。
    // Android 上逻辑高度约 902px，同样装不下 10 条，会原样重演。
    //
    // 改成按 count 反推间距：装得下就用 92px 原值，装不下就压缩，
    // **让「摆 N 条」在任何窗口尺寸下都真的是 N 条**。
    property <length> stack-bottom: root.height - 28px;
    property <length> stack-top: 104px;   // 顶部那段说明文字占掉的高度
    // GL 覆盖开着时多占一格（最底下那格给它），这样「摆 N 条原生」在两种
    // 模式下都还是真的 N 条——上一轮记错档位就是栽在这种地方。
    property <int> total-slots: root.glass-count + (root.gl-own-slot ? 1 : 0);
    // GL 玻璃和上面那条原生胶囊之间额外留的空当。
    //
    // 不是排版偏好：GL 这条的背板要多拷 3σ 的边距（否则模糊到边缘没内容可
    // 采），σ=10 时边距是 30 逻辑像素。两条玻璃靠得比这还近的话，GL 的
    // 背板里就会**采到上面那条原生玻璃**，它的亮边会被糊进 GL 这条的顶边。
    //
    // 这条约束换成真实应用同样成立——两块玻璃离得近到 3σ 以内就会互相
    // 采到。#130 正文把「靠近时的玻璃融合」排在 P1，这里先把它记成一个
    // 已知的物理约束，而不是等到组件库那一轮再撞。
    property <length> gl-gap: root.gl-own-slot ? 40px : 0;
    property <length> slot: Math.min(92px,
        (root.stack-bottom - root.stack-top - root.gl-gap) / Math.max(root.total-slots, 1));
    property <length> capsule-height: Math.max(12px, Math.min(80px, root.slot - 12px));
    // 融合那一档要在胶囊左边空出一个圆的位置。**不空的话在手机上会直接
    // 出界**：机器宽 406 逻辑px，胶囊自己就占 358，圆被推到 x = -68，画面上
    // 看起来像「第二个形状没画出来」，而 logcat 里形状数照样是 2。
    // 实测撞到过（2026-11-25 Android 第一轮 merge）。
    property <length> merge-reserve: root.gl-overlay-mode == 3
        ? root.capsule-height + 24px
        : 0px;
    // 抽成属性是因为 overlay-w 要用同一个值：GL 玻璃和原生胶囊必须一样宽，
    // 否则并排看到的差别里混进了尺寸差。
    property <length> capsule-width: Math.min(root.width - 48px - root.merge-reserve, 430px);

    Timer {
        interval: root.tick-ms * 1ms;
        running: true;
        triggered => {
            // 步长按周期缩放，这样改 tick-ms 只改采样密度，**不改背景的
            // 移动速度**——否则对照两档时背景快慢不同，截图没法并排看。
            root.phase = Math.mod(root.phase + 0.0025 * root.tick-ms / 16, 1.0);
        }
    }

    MovingBackdrop {
        width: 100%;
        height: 100%;
        phase: root.phase;
    }

    // 玻璃条。第一条照首页贴底悬浮，其余是加压用的。
    //
    // 为什么要能摆多个：#130 的质量表要求基准覆盖「单组件 / 5 组件 /
    // 10 组件」。而且单个胶囊在这台机器上根本压不动——帧率被 vsync 钉在
    // 刷新率上，开关 backdrop-blur 两边都是同一个数，测不出代价。
    for k in root.glass-count: GlassCapsule {
        // 和 overlay-x 同一式：两者必须严格对齐，over-* 两档靠的就是
        // 「自绘矩形和第一条原生胶囊是同一个矩形」。
        x: (root.width - self.width) / 2 + root.merge-reserve / 2;
        // +1 格：GL 覆盖开着时最底下那格留给它，见 gl-overlay-visible。
        y: root.stack-bottom - self.height - root.gl-gap
            - (k + (root.gl-own-slot ? 1 : 0)) * root.slot;
        width: root.capsule-width;
        capsule-height: root.capsule-height;
        blur-sigma: root.blur-sigma;
        // over-blur 档下第一条（被自绘盖住的那条）只开模糊，其余照常。
        blur-only: root.native-blur-only && k == 0;

        HorizontalLayout {
            padding: 4px;   // _kIndicatorPaddingInt
            spacing: 0;
            for label in ["首页", "动态", "发现", "我的"]: Rectangle {
                Text {
                    text: label;
                    color: white;
                    font-size: 14px;
                }
            }
        }
    }

    // 自绘的 WGSL 玻璃，摆在原生那条的正上方，为的就是并排看。
    //
    // 两者的差别正是 #130 要的那笔账：原生这条有模糊没折射没高光，
    // 上面这条有折射有高光但**背板是合成的**（见 src/wgpu_probe.rs：
    // 怎么拿到真实背板仍然是没解决的那一关）。
    Image {
        visible: root.probe-visible;
        source: root.probe-texture;
        width: Math.min(root.width - 48px, 430px);
        height: 80px;
        x: (root.width - self.width) / 2;
        y: root.stack-bottom - root.capsule-height - root.slot - 46px;
        image-fit: fill;
    }
    Text {
        visible: root.probe-visible;
        x: 24px;
        y: root.stack-bottom - root.capsule-height - root.slot - 68px;
        text: "↓ 自绘 WGSL（有折射/高光，背板是合成的）　／　再下面一条是原生 backdrop-blur";
        color: #ffffffcc;
        font-size: 12px;
    }

    // GL 覆盖的标注。**必须画在矩形外面**：GL 那一层是在 Slint 画完之后
    // 直接覆盖上去的，落在矩形里的 Slint 内容会被盖掉。
    Text {
        visible: root.gl-overlay-visible;
        x: 24px;
        y: root.stack-bottom - root.capsule-height - 20px;
        text: root.gl-overlay-mode == 0
            ? "↓ 自绘 GL 覆盖：背板是本帧真实帧缓冲（多尺度模糊 + 折射 + Fresnel + 动态高光）　／　↑ 上面是原生 backdrop-blur（只有模糊）"
            : (root.gl-overlay-mode == 1
                ? "↓ 这一条是「原生画全套（模糊+渐变+描边）、自绘只加折射与高光」——要看的是折射有没有把那道 1px 白描边抹开（ADR-016 决策四读法甲）"
                : (root.gl-overlay-mode == 2
                    ? "↓ 这一条是「原生只画模糊，渐变与描边归自绘」——同样是决策四，但自绘采到的背板里没有描边可抹（读法乙）"
                    : "↓ SDF 融合：圆靠近胶囊时长出颈部（smooth union，k=24px）。圆和胶囊是同一个 SDF，只有圆角不同"));
        wrap: word-wrap;
        width: root.width - 48px;
        color: #ffffffcc;
        font-size: 12px;
    }

    // 把这一帧实际跑的档位写在画面上。
    //
    // 这不是调试残留，是 notes §4.1 那条教训的修法：上一轮记录把「10 组件」
    // 那一档记错了，因为档位只存在于环境变量和脚本参数里，截图上看不出来。
    // 参数印在画面上，截图就自带档位，核对不再依赖「我记得当时设的是几」。
    Text {
        x: 24px;
        y: 96px;
        text: "blur-sigma=" + root.blur-sigma / 1px + "px  count=" + root.glass-count
            + "  tick=" + root.tick-ms + "ms"
            + "  slot=" + Math.round(root.slot / 1px) + "px  h=" + Math.round(root.capsule-height / 1px) + "px"
            + "  窗口=" + Math.round(root.width / 1px) + "×" + Math.round(root.height / 1px)
            + (root.gl-status == "" ? "" : "\n" + root.gl-status)
            // 融合那一档把实际间距也印出来：它是这一档唯一要读的数。
            + (root.overlay2-visible
                ? "  间距=" + Math.round(root.merge-gap / 1px) + "px"
                : "");
        color: #ffffffcc;
        font-size: 13px;
    }

    // 把「这一版缺什么」写在画面上。截图会进记录，而记录的读者未必记得
    // 原生 backdrop-blur 做不到哪两件事。
    Text {
        x: 24px;
        y: root.height - 24px - self.height;
        text: "原生 backdrop-blur：没有边缘折射（liquid_glass.frag 的 rim 15px / 偏移 7px），没有单点高光（glint 0.18 / 带宽 4px）。";
        wrap: word-wrap;
        width: root.width - 48px;
        color: #ffffff99;
        font-size: 12px;
    }
}
