// SPIKE-001 的 UI 层。**这里只负责画**：位置、透明度、是否显示角标全部由
// Rust 算好传进来（AGENTS.md §2 的铁律——换掉宿主框架时这段不该重写）。
//
// 这一层要验证的是三件事：
//   1. Window 背景透明时，底下用 mpv 的 OpenGL render API 画的视频能否透出来；
//   2. 几百条文本叠在视频上还能不能保持帧率；
//   3. 层级是否稳定（弹幕永远在视频之上、HUD 永远在弹幕之上）。

export struct DanmakuItem {
    // 文本已含合并角标（Rust 侧拼好，见 overlay.rs）
    text: string,
    x: length,
    y: length,
    size: length,
    color: color,
    alpha: float,
}

export component SpikeWindow inherits Window {
    in property <[DanmakuItem]> items;
    in property <string> hud;
    in property <bool> hud-visible: true;
    // 没有 mpv 时铺一层底色，好让弹幕层自己也能看清；有 mpv 时**必须**保持
    // 不画，否则会把底下的视频盖掉——这正是本次要验的东西。
    in property <bool> video-active: false;
    in property <string> watermark;
    // 下面这一组只有 Android 探针用（SPIKE-002 的触摸分发与 PiP 两项）。
    // 桌面那条路（src/main.rs）不打开它，免得实验台多出两个按钮，
    // 把 SPIKE-001 量的帧耗时也一起改了。
    in property <bool> controls-visible: false;
    // 按钮中心的**绝对坐标**（逻辑像素）。驱动脚本要 `adb shell input tap`
    // 点中它，就得知道点哪儿；窗口尺寸会随旋转和 PiP 变，所以这个值必须由
    // 布局算出来再读回 Rust，不能在 Rust 里按常数猜。
    out property <length> pip-cx: pip-button.x + pip-button.width / 2;
    out property <length> pip-cy: pip-button.y + pip-button.height / 2;
    out property <length> shot-cx: shot-button.x + shot-button.width / 2;
    out property <length> shot-cy: shot-button.y + shot-button.height / 2;

    callback key(string);
    // kind 是 "down" / "up" / "move" / "cancel"，坐标是逻辑像素。
    callback touch(string, length, length);
    callback pip-pressed();
    callback shot-pressed();

    title: "KiliKili SPIKE-001 · Slint + libmpv";
    // 透明背景是整个方案的前提：femtovg 用它清屏，mpv 在 BeforeRendering
    // 里已经把这一帧的视频画进同一个 framebuffer 了。
    background: transparent;
    preferred-width: 1280px;
    preferred-height: 720px;

    if !root.video-active: Rectangle {
        background: @linear-gradient(180deg, #10141c 0%, #1d2430 100%);
    }

    // 铺满整个窗口的触摸层，**放在最底下**：它只接没有被上面的按钮抢走的
    // 事件。两者区分得开，才说明命中测试真的在工作——而不是「反正都报一次」。
    //
    // 它在视频之上（视频是 BeforeRendering 里画进同一个 FBO 的，根本不在
    // Slint 的元素树里），所以这一层能收到事件，本身就是 #9 要的那个答案：
    // 视频垫在底下不会吃掉触摸。
    if root.controls-visible: surface-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(e) => {
            root.touch(
                e.kind == PointerEventKind.down ? "down"
                    : e.kind == PointerEventKind.up ? "up"
                    : e.kind == PointerEventKind.move ? "move"
                    : "cancel",
                surface-touch.mouse-x,
                surface-touch.mouse-y);
        }
    }

    // 描边：Slint 的 Text 没有 stroke，用一层偏移的黑字顶替。代价是文本
    // 绘制次数翻倍——这是**故意**算进帧率里的，真实弹幕必须有描边，不然
    // 亮底上看不见。
    for item in root.items: Text {
        x: item.x + 1.5px;
        y: item.y + 1.5px;
        text: item.text;
        font-size: item.size;
        font-weight: 700;
        color: #000000;
        opacity: item.alpha * 0.55;
    }

    for item in root.items: Text {
        x: item.x;
        y: item.y;
        text: item.text;
        font-size: item.size;
        font-weight: 700;
        color: item.color;
        opacity: item.alpha;
    }

    if root.watermark != "": Text {
        x: 16px;
        y: parent.height - self.height - 16px;
        text: root.watermark;
        font-size: 13px;
        color: #ffffffcc;
    }

    if root.hud-visible: Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: hud-text.width + 20px;
        height: hud-text.height + 16px;
        background: #000000b4;
        border-radius: 8px;

        hud-text := Text {
            x: 10px;
            y: 8px;
            text: root.hud;
            font-family: "Consolas";
            font-size: 12px;
            color: #aef6c5;
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            root.key(event.text);
            accept
        }
    }

    // 两个按钮**无条件存在**（只是隐藏）：`pip-cx` 这些 out property 要引用
    // 它们的几何，而 Slint 的 `if` 里的元素在外面取不到 id。隐藏的元素不收
    // 触摸事件，所以桌面那条路上它们既不画也不挡。
    // 宽度刻意小：手机竖屏按逻辑像素只有 400 出头（1116 物理 / 2.75），
    // 两个 240px 的按钮会在中间**叠起来**，后面那个盖住前面那个——第一轮实跑
    // 就是这么把「点 PiP 按钮」点成了「点 SHOT 按钮」。
    pip-button := Rectangle {
        visible: root.controls-visible;
        x: 24px;
        y: parent.height - self.height - 24px;
        width: 150px;
        height: 110px;
        background: pip-touch.pressed ? #2b6cb0 : #1a365dcc;
        border-radius: 12px;
        border-width: 2px;
        border-color: #63b3ed;

        Text {
            text: "PiP";
            font-size: 34px;
            font-weight: 700;
            color: #ffffff;
        }

        pip-touch := TouchArea {
            clicked => {
                root.pip-pressed();
            }
        }
    }

    shot-button := Rectangle {
        visible: root.controls-visible;
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 24px;
        width: 150px;
        height: 110px;
        background: shot-touch.pressed ? #2f855a : #1c4532cc;
        border-radius: 12px;
        border-width: 2px;
        border-color: #68d391;

        Text {
            text: "SHOT";
            font-size: 34px;
            font-weight: 700;
            color: #ffffff;
        }

        shot-touch := TouchArea {
            clicked => {
                root.shot-pressed();
            }
        }
    }

    init => {
        fs.focus();
    }
}
